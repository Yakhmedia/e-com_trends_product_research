# Copy to .env and fill in every value. Do not commit the filled-in file —
# .gitignore already covers .env*.

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API → Project URL.
# Bare origin only: no /rest/v1, no path, no trailing slash. supabase-js
# appends /auth/v1 and /rest/v1 itself.
NEXT_PUBLIC_SUPABASE_URL=

# Dashboard → Settings → API → anon / public key. Safe to ship in the bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dashboard → Settings → API → service_role key. Bypasses RLS.
# Server-only — never prefix NEXT_PUBLIC_. Required in production.
SUPABASE_SERVICE_ROLE_KEY=

# ── Third-party APIs (server-only) ──────────────────────────────────────────
# Note: the NEXT_ prefix is meaningless in Next.js — only NEXT_PUBLIC_ is
# special. These must be named exactly as below or the code reads undefined.

# serpapi.com → Dashboard → Your Private API Key
SERP_API_KEY=

# platform.openai.com → API keys.
# Now the SHARED TRIAL key: users without their own provider key (set per-user
# in /settings, stored in Supabase Vault) get a hard lifetime trial of
# SERVER_TRIAL_LIMIT messages on this key before BYOK is required
# (lib/usage.ts). Leave unset to require BYOK from everyone.
OPENAI_API_KEY=

# ── Sentry ──────────────────────────────────────────────────────────────────
# sentry.io → Project → Settings → Client Keys (DSN). Optional but recommended.
NEXT_PUBLIC_SENTRY_DSN=
